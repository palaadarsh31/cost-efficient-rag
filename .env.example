# Copy to .env and fill in. Real environment variables take precedence over this file.

# --- index ---------------------------------------------------------------
RAG_DB_PATH=data/index/docqa.db
CHUNK_SIZE=350
CHUNK_OVERLAP=50

# --- embeddings (local ONNX model via fastembed, downloaded on first use) ---
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
# EMBED_BACKEND=openai            # any OpenAI-compatible /embeddings endpoint instead
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_MODEL=nomic-embed-text
# EMBED_QUERY_PREFIX=             # empty for models that don't want a query instruction

# --- retrieval -----------------------------------------------------------
TOP_K=5
RETRIEVAL_MODE=hybrid
MIN_SCORE=0.5

# --- generation: any OpenAI-compatible /chat/completions endpoint -----------
# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Anthropic Claude through its OpenAI-compatible endpoint (what results/ was produced with)
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-sonnet-5-5
# LLM_TEMPERATURE=none            # newer Claude models reject the temperature parameter
# LLM_API_KEY=

# Google Gemini (free tier works)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_API_KEY=

# Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=

# Ollama (local, no key)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# Provider-specific request fields as JSON, e.g. to turn off "thinking":
# LLM_EXTRA_BODY={"reasoning_effort": "none"}

# --- evaluation judge (defaults to the generation settings) -----------------
# JUDGE_BASE_URL=
# JUDGE_MODEL=
# JUDGE_API_KEY=

# Optional, only used to print generation cost per 1k queries in the eval report
# LLM_PRICE_INPUT_PER_M=0.15
# LLM_PRICE_OUTPUT_PER_M=0.60

QUERY_LOG_PATH=logs/queries.jsonl
LOG_LEVEL=INFO

# --- Problem 2: Independent LLM-as-judge pipeline ---------------------------
# Use models from different families. Never commit a real API key.
# Example: generator GPT family, judge Gemini family.
# GENERATOR_BASE_URL=https://api.openai.com/v1
# GENERATOR_MODEL=gpt-4o-mini
# GENERATOR_API_KEY=
# JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# JUDGE_MODEL=gemini-2.5-flash
# JUDGE_API_KEY=
# JUDGE_TEMPERATURE=0
# JUDGE_INPUT_USD_PER_M=0
# JUDGE_OUTPUT_USD_PER_M=0

# --- Problem 2: native Anthropic judge (optional; choose this or the example above) ---
# JUDGE_PROVIDER=anthropic
# JUDGE_BASE_URL=https://api.anthropic.com/v1
# JUDGE_MODEL=<enter an Anthropic model available to your account>
# JUDGE_TEMPERATURE=none           # current Claude models reject this legacy field
# Set key with a secure prompt (--prompt-for-key); NEVER paste it in this file.
# For existing curated answers, GENERATOR_MODEL=reference-written and --allow-same-family
# avoids falsely claiming they were produced by a specific model.
